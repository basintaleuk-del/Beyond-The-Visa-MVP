# Existing Supabase browser and server configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Optional alias used by Vercel server functions during key rotation
SUPABASE_SECRET_KEY=server-only-secret-key

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=public-vapid-key
VAPID_PRIVATE_KEY=server-only-private-vapid-key
VAPID_SUBJECT=mailto:support@beyondthevisa.org

# Existing Vercel scheduler authentication
CRON_SECRET=long-random-server-only-secret

# Jooble Jobs (server-side only; never prefix this variable with NEXT_PUBLIC_)
JOOBLE_API_KEY=server-only-jooble-api-key

# Careerjet Jobs (server-side only; never prefix this variable with NEXT_PUBLIC_)
CAREERJET_AFFILIATE_ID=server-only-careerjet-api-key

# Additional job providers (server-side only)
REED_API_KEY=server-only-reed-api-key
ADZUNA_APP_ID=server-only-adzuna-application-id
ADZUNA_APP_KEY=server-only-adzuna-application-key
USAJOBS_API_KEY=server-only-usajobs-api-key
USAJOBS_USER_AGENT=support@beyondthevisa.org

# Supabase Edge Function secrets (configure with Supabase, not as browser vars)
GEMINI_API_KEY=server-only-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=server-only-elevenlabs-api-key
PAYSTACK_SECRET_KEY=server-only-paystack-secret-key
APP_URL=https://beyondthevisa.org

# Preview-only isolation guard. Store SHA-256 fingerprints, never production values.
BTV_PRODUCTION_SUPABASE_PROJECT_REF=wuvgktmzkzrdvbpqfmek
BTV_PRODUCTION_SERVICE_ROLE_SHA256=64-character-sha256-fingerprint
BTV_PRODUCTION_PAYSTACK_SECRET_SHA256=64-character-sha256-fingerprint
