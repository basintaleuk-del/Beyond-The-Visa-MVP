{
  "redirects": [
    { "source": "/costs", "destination": "/opportunities", "permanent": true },
    { "source": "/cost-planner", "destination": "/opportunities", "permanent": true },
    { "source": "/admin", "destination": "/admin.html", "permanent": false },
    { "source": "/admin/", "destination": "/admin.html", "permanent": false },
    { "source": "/dashboard/admin", "destination": "/admin.html", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": false },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/blog/articles", "destination": "/blog/", "permanent": true },
    { "source": "/web/:path*.html", "destination": "/:path*.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/usa-jobs-connection-test", "destination": "/api/usa-jobs-import?mode=connection-test" },
    { "source": "/api/adzuna-jobs-connection-test", "destination": "/api/usa-jobs-import?provider=adzuna&mode=connection-test" },
    { "source": "/api/adzuna-jobs-import", "destination": "/api/usa-jobs-import?provider=adzuna" },
    { "source": "/api/adzuna-jobs-sample", "destination": "/api/usa-jobs-import?provider=adzuna&mode=sample-import" },
    { "source": "/api/reed-jobs-connection-test", "destination": "/api/global-jobs-import?provider=reed&mode=connection-test" },
    { "source": "/api/reed-jobs-import", "destination": "/api/global-jobs-import?provider=reed" },
    { "source": "/api/reed-jobs-sample", "destination": "/api/global-jobs-import?provider=reed&mode=sample-import" },
    { "source": "/jobs/usa", "destination": "/index.html" },
    { "source": "/jobs/usa/:id", "destination": "/index.html" },
    { "source": "/jobs", "destination": "/index.html" },
    { "source": "/jobs/:id", "destination": "/index.html" },
    { "source": "/opportunities", "destination": "/index.html?screen=opportunities" },
    { "source": "/journey/tools/cost-estimator", "destination": "/index.html?screen=cost-estimator" },
    { "source": "/clinical-learning/:slug", "destination": "/adult-nursing.html" }
  ],
  "crons": [
    { "path": "/api/global-jobs-import", "schedule": "15 3 * * *" },
    { "path": "/api/immigration-news", "schedule": "45 4 * * *" },
    { "path": "/api/notification-scheduler", "schedule": "15 5 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|webp|svg|woff2|woff|ico)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
